PORT=3000
DATABASE_PATH=./data/leads.sqlite
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters-long
WORKSPACE_ID=main

# Add the web app's origin if using Expo web. Native mobile requests do not send an Origin.
ALLOWED_ORIGINS=http://localhost:8081,http://127.0.0.1:8081,http://localhost:8082,http://127.0.0.1:8082

# Optional OpenAI-compatible planning service. Leave unset to use private local suggestions.
AI_API_ENDPOINT=
AI_API_KEY=
AI_MODEL=
