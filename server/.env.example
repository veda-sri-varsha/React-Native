PORT=3000
DATABASE_PATH=./data/leads.sqlite
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters-long
WORKSPACE_ID=main

# Keep public registration disabled for a shared workspace.
ALLOW_PUBLIC_SIGNUP=false
SIGNUP_INVITE_CODE=replace-with-a-long-random-invite-code

# Add the web app's origin if using Expo web. Native mobile requests do not send an Origin.
ALLOWED_ORIGINS=http://localhost:8081,http://127.0.0.1:8081,http://localhost:8082,http://127.0.0.1:8082

# Optional OpenAI-compatible planning service. Leave unset to use private local suggestions.
AI_API_ENDPOINT=
AI_API_KEY=
AI_MODEL=

# Configure these values from your Meta app and Page settings.
META_WEBHOOK_VERIFY_TOKEN=replace-with-a-random-webhook-verification-token
META_APP_SECRET=replace-with-your-meta-app-secret
META_PAGE_ACCESS_TOKEN=replace-with-a-page-access-token
META_PAGE_ID=replace-with-your-page-id
META_GRAPH_API_VERSION=vXX.X
